/.bundle/
/pkg/
/tmp/
*.gem

# Per-Appraisal gemfile locks: regenerated per Ruby version in CI so each leg resolves a
# compatible Rails (the root Gemfile.lock is committed for reproducible dev).
gemfiles/*.gemfile.lock

# Dummy app runtime artifacts
test/dummy/db/*.sqlite3
test/dummy/db/*.sqlite3-*
test/dummy/*.db
test/dummy/log/*
test/dummy/tmp/*
test/dummy/storage/*
!test/dummy/log/.keep

# gstack working state (deploy reports, tmp, analytics)
.gstack/
